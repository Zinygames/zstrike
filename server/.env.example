# Copy to .env (never commit .env). All values optional.
PORT=8080
CLUSTER=devnet                 # v1 is devnet-only
RPC_URL=https://api.devnet.solana.com
TREASURY=EiitkVBCV75BgSxrGMjr49if3Ug4n3orgvvE7E5vU6iH   # PUBLIC address that receives the house cut
LOBBY_SIZE=10
ENTRY_USD=2
WINNER_SHARE=0.5               # 10 x $2 = $20 pot -> $10 winner, $10 treasury
MATCH_SECONDS=300
VOTE_SECONDS=10                # map vote countdown once the lobby is full
TEST_MODE=1                    # 1 = allow free test lobbies filled with bots (no money)
FALLBACK_SOL_USD=150           # used when CoinGecko is unreachable
# ESCROW_SECRET_KEY=[...]      # optional: escrow keypair as JSON array (for hosts like Render).
                               # If unset, server generates secrets/escrow.json on first run.
